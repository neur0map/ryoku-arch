[Unit]
# refreshes the ~/.cache/{claude,codex,opencode}-usage.json caches the qsbar
# AI pill reads; driven by ryoku-ai-usage.timer, never enabled on its own.
Description=Ryoku AI usage collectors

[Service]
Type=oneshot
# the dev deploy rewrites these to ~/.local/bin; the package ships /usr/bin.
# every line is '-' prefixed: a missing tool (no codex, no opencode db, no
# claude creds) is the normal case and must never fail the unit or the timer.
ExecStart=-/usr/bin/claude-usage
ExecStart=-/usr/bin/codex-usage
ExecStart=-/usr/bin/opencode-usage
