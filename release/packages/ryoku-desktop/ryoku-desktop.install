_hint() {
  cat <<'EOF'
==> Run `ryoku materialize` as your user to lay the Ryoku base configs into
    ~/.config (login does this automatically; root cannot write a user's home).
EOF
}

# refresh the hicolor icon cache and the desktop database so shipped entries
# (the Ryoku VM launcher and its icon) resolve in the app launcher without a
# relogin. both guarded: absent tools are skipped, a stale run never fails.
_refresh() {
  if command -v gtk-update-icon-cache >/dev/null 2>&1; then
    gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor 2>/dev/null || true
  fi
  if command -v update-desktop-database >/dev/null 2>&1; then
    update-desktop-database -q /usr/share/applications 2>/dev/null || true
  fi
}

# enable bluetooth.service exactly once, so installs that predate the bluez
# dependency get a running bluetoothd on upgrade (the shell/hub Bluetooth UIs
# are dead without it). The marker keeps this one-shot: a user who later
# disables the service stays disabled across upgrades. `start` only fires on a
# booted system; inside the installer chroot the enable symlink is enough.
_bluetooth() {
  [ -e /usr/lib/systemd/system/bluetooth.service ] || return 0
  local marker=/var/lib/ryoku/bluetooth-enabled
  [ -e "$marker" ] && return 0
  systemctl enable bluetooth.service 2>/dev/null || true
  if [ -d /run/systemd/system ]; then
    systemctl start bluetooth.service 2>/dev/null || true
  fi
  mkdir -p /var/lib/ryoku && : >"$marker"
}

# enable rtkit-daemon exactly once, so installs that predate the rtkit dependency
# get realtime scheduling for PipeWire on upgrade. without it PipeWire runs
# SCHED_OTHER and the audio thread underruns into crackling under load. Marker
# keeps it one-shot: a user who later disables it stays disabled across upgrades.
_rtkit() {
  [ -e /usr/lib/systemd/system/rtkit-daemon.service ] || return 0
  local marker=/var/lib/ryoku/rtkit-enabled
  [ -e "$marker" ] && return 0
  systemctl enable rtkit-daemon.service 2>/dev/null || true
  if [ -d /run/systemd/system ]; then
    systemctl start rtkit-daemon.service 2>/dev/null || true
  fi
  mkdir -p /var/lib/ryoku && : >"$marker"
}

# enable power-profiles-daemon exactly once, so power-mode switching persists and
# the daemon is reliably running -- it is only D-Bus activated otherwise, and the
# shell's power-profile UI silently fails when it isn't up. Marker keeps it
# one-shot: a user who later disables the service stays disabled across upgrades.
# `start` only fires on a booted system; inside the installer chroot the enable
# symlink is enough.
_powerprofiles() {
  [ -e /usr/lib/systemd/system/power-profiles-daemon.service ] || return 0
  local marker=/var/lib/ryoku/power-profiles-enabled
  [ -e "$marker" ] && return 0
  systemctl enable power-profiles-daemon.service 2>/dev/null || true
  if [ -d /run/systemd/system ]; then
    systemctl start power-profiles-daemon.service 2>/dev/null || true
  fi
  mkdir -p /var/lib/ryoku && : >"$marker"
}

# reload logind so the lid-policy drop-in (10-ryoku-lid.conf) applies without a
# reboot. reload is session-safe (unlike restart, which drops sessions); only on
# a booted system -- the installer chroot reads the drop-in on first boot.
_logind_lid() {
  [ -d /run/systemd/system ] || return 0
  systemctl reload systemd-logind 2>/dev/null || true
}

# tune bluez main.conf in place (Experimental battery reporting, fast + robust
# reconnect, AutoEnable). bluez owns the file and BlueZ has no drop-in dir, so
# Ryoku edits it idempotently instead of shipping a conflicting copy. Re-applied
# on upgrade in case a bluez update reset it; restart bluetoothd so keys apply now.
_bluetooth_tune() {
  command -v ryoku-bluetooth-tune >/dev/null 2>&1 || return 0
  ryoku-bluetooth-tune >/dev/null 2>&1 || true
  if [ -d /run/systemd/system ]; then
    systemctl try-restart bluetooth.service 2>/dev/null || true
  fi
}

# ASUS AMD+NVIDIA panels register only nvidia_wmi_ec_backlight and hide
# amdgpu_bl0, so brightness will not lower. ryoku-hw-backlight-fix adds
# acpi_backlight=native (hardware-gated + idempotent, a no-op on every other
# box) and bakes it into the UKI. Takes effect on the next reboot.
_backlight_fix() {
  command -v ryoku-hw-backlight-fix >/dev/null 2>&1 || return 0
  ryoku-hw-backlight-fix >/dev/null 2>&1 || true
}

# enable the AI-usage collector timer exactly once via --global, so every user
# picks it up (the units live in /usr/lib/systemd/user). --global only writes the
# timers.target.wants symlink; the timer arms on the user's next login. Marker
# keeps it one-shot: a user who later disables it stays disabled across upgrades.
_ai_usage_timer() {
  [ -e /usr/lib/systemd/user/ryoku-ai-usage.timer ] || return 0
  local marker=/var/lib/ryoku/ai-usage-timer-enabled
  [ -e "$marker" ] && return 0
  systemctl --global enable ryoku-ai-usage.timer 2>/dev/null || true
  mkdir -p /var/lib/ryoku && : >"$marker"
}

post_install() {
  _refresh
  _bluetooth
  _bluetooth_tune
  _backlight_fix
  _rtkit
  _powerprofiles
  _logind_lid
  _ai_usage_timer
  _hint
}

post_upgrade() {
  _refresh
  _bluetooth
  _bluetooth_tune
  _backlight_fix
  _rtkit
  _powerprofiles
  _logind_lid
  _ai_usage_timer
  _hint
}

post_remove() {
  _refresh
}
